{
  "name": "fibery-html-editor",
  "version": "8.47.1",
  "private": true,
  "description": "Fibery HTML Editor modular source and single-file build",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:tmp": "node scripts/build.mjs --out .tmp/index.generated.html",
    "validate:tmp": "node scripts/validate-build.mjs .tmp/index.generated.html --baseline index.html",
    "build": "node scripts/build.mjs --out index.html",
    "validate": "node scripts/validate-build.mjs index.html",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
