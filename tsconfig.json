{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "allowJs": false,
    "checkJs": false,
    "types": []
  },
  "include": [
    "source/app/**/*.ts",
    "source/js/**/*.ts",
    "source/types/**/*.ts",
    "source/types/**/*.d.ts"
  ],
  "exclude": [
    "index.html",
    ".tmp",
    "node_modules",
    "docs",
    ".git"
  ]
}
